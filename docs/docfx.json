{
  "metadata": [{
    "src": [{ "src": "../src/MovieApi", "files": ["MovieApi.csproj"] }],
    "dest": "api",
    "filter": "api-filter.yml"
  }],
  "build": {
    "content": [{ "files": ["index.md", "toc.yml", "guides/*.md", "guides/toc.yml", "architecture/*.md", "architecture/toc.yml", "api/*.yml"] }],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": { "_appName": "MovieApi" }
  }
}
